# Payment screenshot vision verification (OpenRouter)
OPENROUTER_API_KEY=
# Optional model override; default is the vision-capable model below.
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-5
# Backup payment screenshot verification (xAI)
XAI_API_KEY=
# Optional model override; defaults to grok-4.3-latest.
XAI_VISION_MODEL=

# Public site URL (no trailing slash)
# Local: http://localhost:3000
# Production: https://www.theprotocolau.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Convex (orders + Convex Auth)
# Local: filled by `npx convex dev` (may be anonymous → http://127.0.0.1:3210)
# Production: cloud URL from `npx convex deploy` (https://….convex.cloud)
# Also set on Vercel Production: NEXT_PUBLIC_CONVEX_URL
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Convex Auth keys — generate once and set on the Convex deployment:
#   npx @convex-dev/auth
# SITE_URL is the public site origin (local: http://localhost:3000).
# Also set RESEND_API_KEY and RESEND_FROM_EMAIL on Convex for welcome email:
#   npx convex env set RESEND_API_KEY '<same as Vercel>'
#   npx convex env set RESEND_FROM_EMAIL 'contact@theprotocolau.com'
#   npx convex env set SITE_URL 'https://theprotocolau.com'
# Shared secret: Next.js payment routes → Convex order mutations
# Generate a long random string; set the SAME value in Convex AND on Vercel:
#   npx convex env set ORDERS_WEBHOOK_SECRET '<same-value>'
#   vercel env add ORDERS_WEBHOOK_SECRET production
ORDERS_WEBHOOK_SECRET=

# Freshnup hosted payment bridge (same PAYMENT_BRIDGE_SECRET on both Vercel projects)
PAYMENT_BRIDGE_SECRET=
FRESHNUP_PAYMENT_URL=https://www.freshnup.global/pay

# Stripe test mode — replace placeholders with Dashboard test keys.
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Paid-order email notifications (Resend)
RESEND_API_KEY=
# Must use a domain verified in the Resend dashboard.
RESEND_FROM_EMAIL=contact@theprotocolau.com
# Merchant copy is sent by BCC. RESEND_TO_OPS is supported as a fallback alias.
ORDERS_NOTIFY_EMAIL=orders@theprotocolau.com
RESEND_TO_OPS=
# Replace these example values with the real postal return address.
SHIPPING_FROM_NAME=The Protocol
SHIPPING_FROM_LINE1=123 Example Street
SHIPPING_FROM_CITY=Sydney
SHIPPING_FROM_STATE=NSW
SHIPPING_FROM_POSTCODE=2000
SHIPPING_FROM_COUNTRY=Australia

# USDC settlement destinations (server-only; defaults match merchant receive screens)
PAYMENT_ETHEREUM_USDC_ADDRESS=0x22ca069363df8cf72c1d900e001c218e1fb62025
PAYMENT_SOLANA_USDC_ADDRESS=EbqrjfM5dYTiuQcJmgf5sw2968HkGb3dQUaokm6AGoi8
# Mainnet JSON-RPC URLs are required for automatic on-chain completion.
ETH_RPC_URL=
SOLANA_RPC_URL=
# Mainnet USDC identifiers; override only if intentionally changing token.
ETHEREUM_USDC_CONTRACT=0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Bank transfer settlement (server-only; defaults match merchant account)
BANK_ACCOUNT_NAME=The Protocol
BANK_BSB=645646
BANK_ACCOUNT_NUMBER=108361845
